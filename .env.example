# Copy to .env. Keep the actual password out of Git.
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-unique-password
POSTGRES_DB=agent_service
API_HOST_PORT=8001
# For a VPS deployment, set this to the private persistent host directory.
# Local development uses ./agent-service/app/data/uploads by default.
# UPLOADS_HOST_DIR=/var/lib/sightbridge-agent/uploads
