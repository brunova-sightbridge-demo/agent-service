# Backend
DATABASE_URL=postgresql+psycopg://agent:replace-with-a-unique-password@db:5432/agent_service
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
MODEL_NAME=gpt-4o-mini
LLM_SERVICE_URL=http://llm-service:8200/generate
LLM_SERVICE_STREAM_URL=http://llm-service:8200/generate/stream
LLM_SERVICE_TIMEOUT_SECONDS=20
READINESS_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
EMBEDDING_SERVICE_URL=http://embedding-service:8100/embed
EMBEDDING_SERVICE_TIMEOUT_SECONDS=5

# Local CORS
ALLOWED_ORIGINS=http://localhost:8766,http://127.0.0.1:8766,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5176

# Chat validation and limits
CHAT_ALLOWED_ROLES=
CHAT_MAX_QUESTION_CHARS=800
STRICT_VALIDATION=true
RATE_LIMIT_ENABLED=true
CHAT_IP_LIMIT=30
CHAT_ID_LIMIT=15
CHAT_RATE_WINDOW_SECONDS=300

# Timeouts
AGENT_TIMEOUT_SECONDS=25
LLM_TIMEOUT_SECONDS=20
EMBED_TIMEOUT_SECONDS=10

# Metrics
METRICS_WINDOW_SECONDS=3600
METRICS_MAX_SAMPLES=2000
METRICS_MAX_EVENTS=5000

# Uploads and ingestion
UPLOAD_ASYNC_ENABLED=true
UPLOAD_QUEUE_NAME=ingest:default
MAX_UPLOAD_MB=20
ALLOWED_EXTS=.pdf,.docx,.txt,.md,.html
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/html
UPLOAD_MAX_PAGES=200
UPLOAD_MAX_PARAGRAPHS=2000
UPLOAD_AV_POLICY=allow

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google verifies identity; the database allowlist controls access and roles.
OIDC_ENABLED=true
CHAT_LOGIN_REQUIRED=true
CHAT_SHOW_CITATIONS=true
ANSWER_REQUIRE_SOURCES=true
SOURCE_MIN_SCORE=0.55
NO_SOURCE_MESSAGE=No encuentro una fuente suficiente para responder con seguridad.
AGENT_NAME=Sightbridge Advisor AI Demo
AGENT_PURPOSE=Explain public sources about 1031 exchanges, Delaware statutory trusts, and Section 721 contributions to REIT operating partnerships.
AGENT_SCOPE_POLICY=Answer general source-backed questions about any of these subjects individually or in combination: Section 1031 like-kind real estate exchanges; Delaware statutory trusts; Section 721 contributions to REIT operating partnerships; risks and limits of non-traded REITs; and Sightbridge's public strategy materials. Questions about the loaded IRS article Like-kind exchanges -- real estate tax tips are in scope, including unusual property examples explicitly discussed there. Decline unrelated topics. Use only the public sources loaded for this demo.
AGENT_ADVICE_POLICY=Do not provide personalized tax, legal, or investment advice, recommend a specific transaction, or evaluate an individual's eligibility. Explain general source-backed rules and suggest consulting a qualified professional.
AGENT_DISCLAIMER_ES=Información general; no sustituye asesoría fiscal, legal ni financiera profesional.
AGENT_DISCLAIMER_EN=General information only; not a substitute for professional tax, legal, or financial advice.
AGENT_SCOPE_REFUSAL_ES=
AGENT_SCOPE_REFUSAL_EN=
AGENT_ADVICE_REFUSAL_ES=
AGENT_ADVICE_REFUSAL_EN=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8001/auth/google/callback
OIDC_SESSION_SECRET=
OIDC_BOOTSTRAP_ADMINS=
OIDC_CHAT_URL=http://localhost:8766
OIDC_CONSOLE_URL=http://localhost:5176
